#!/bin/bash
# Cross-platform commit-msg hook wrapper.
# Resolves the script directory without readlink -f (macOS BSD readlink lacks -f),
# then invokes PowerShell with the correct binary name for each platform.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Detect PowerShell: prefer `pwsh` (PowerShell Core, cross-platform) over
# `powershell.exe` (Windows PowerShell, Windows-only).  PowerShell 7+ is
# required for full cmdlet compatibility; Windows PowerShell 5.1 works for
# this hook but pwsh is preferred when available on Windows too.
if command -v pwsh >/dev/null 2>&1; then
    PS=pwsh
elif command -v powershell.exe >/dev/null 2>&1; then
    PS=powershell.exe
elif command -v powershell >/dev/null 2>&1; then
    PS=powershell
else
    echo "COMMIT REJECTED: no PowerShell (pwsh) found. Install PowerShell Core." >&2
    exit 1
fi

"$PS" -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_DIR/commit-msg.ps1" "$@"
exit $?